<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema do app (AndroidManifest: android:theme="@style/Theme.Almoxarifado") -->
    <style name="Theme.Almoxarifado" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/aco</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/pendente_fundo</item>
        <item name="colorOnPrimaryContainer">@color/aco</item>
        <item name="colorSecondary">@color/sinalizacao</item>
        <item name="colorOnSecondary">@color/tinta</item>
        <item name="colorSecondaryContainer">@color/aco</item>
        <item name="colorOnSecondaryContainer">@color/branco</item>
        <item name="colorError">@color/erro</item>
        <item name="colorOnError">@color/branco</item>
        <item name="colorErrorContainer">@color/erro_fundo</item>
        <item name="colorOnErrorContainer">@color/erro</item>
        <item name="android:colorBackground">@color/concreto</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/tinta</item>
        <item name="colorOnSurfaceVariant">@color/grafite</item>
        <item name="colorOutline">@color/grafite</item>
        <item name="colorOutlineVariant">@color/borda</item>
        <item name="android:statusBarColor">@color/aco_escuro</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="materialButtonStyle">@style/Widget.Almox.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Almox.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.Almox.Card</item>
        <item name="textInputStyle">@style/Widget.Almox.TextInput</item>
    </style>

    <!-- Botões -->
    <style name="Widget.Almox.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Almox.Botao</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">24dp</item>
    </style>

    <style name="Widget.Almox.Button.Accent">
        <item name="backgroundTint">@color/sinalizacao</item>
        <item name="android:textColor">@color/tinta</item>
        <item name="iconTint">@color/tinta</item>
    </style>

    <style name="Widget.Almox.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Almox.Botao</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aco</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/aco</item>
        <item name="strokeWidth">2dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/aco</item>
    </style>

    <style name="Widget.Almox.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Almox.Botao</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/aco</item>
    </style>

    <!-- Cartões -->
    <style name="Widget.Almox.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/borda</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Campos de texto -->
    <style name="Widget.Almox.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintTextColor">@color/aco</item>
    </style>

    <style name="Widget.Almox.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintTextColor">@color/aco</item>
    </style>

    <!-- Barra superior -->
    <style name="Widget.Almox.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/aco</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/branco</item>
        <item name="titleTextAppearance">@style/TextAppearance.Almox.Toolbar</item>
        <item name="navigationIconTint">@color/branco</item>
    </style>

    <!-- Chips de status (TextView com fundo arredondado) -->
    <style name="Almox.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Almox.Chip</item>
    </style>
    <style name="Almox.Chip.Estoque" parent="Almox.Chip">
        <item name="android:backgroundTint">@color/sucesso</item>
        <item name="android:textColor">@color/branco</item>
    </style>
    <style name="Almox.Chip.Alerta" parent="Almox.Chip">
        <item name="android:backgroundTint">@color/alerta_fundo</item>
        <item name="android:textColor">@color/alerta_texto</item>
    </style>
    <style name="Almox.Chip.Erro" parent="Almox.Chip">
        <item name="android:backgroundTint">@color/erro_fundo</item>
        <item name="android:textColor">@color/erro</item>
    </style>
    <style name="Almox.Chip.Pendente" parent="Almox.Chip">
        <item name="android:backgroundTint">@color/pendente_fundo</item>
        <item name="android:textColor">@color/pendente_texto</item>
    </style>

    <!-- Tipografia.
         Fontes embutidas do Android: sans-serif-condensed e monospace.
         Para usar Barlow Condensed / IBM Plex Mono, adicione-as em Downloadable Fonts
         e troque o valor de android:fontFamily abaixo. -->
    <style name="TextAppearance.Almox" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/tinta</item>
    </style>
    <style name="TextAppearance.Almox.TituloGrande">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">44sp</item>
    </style>
    <style name="TextAppearance.Almox.Titulo">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.Almox.Secao">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/aco</item>
    </style>
    <style name="TextAppearance.Almox.Nome">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.Almox.Corpo">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Almox.Detalhe">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/grafite</item>
    </style>
    <style name="TextAppearance.Almox.Rotulo">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/grafite</item>
    </style>
    <style name="TextAppearance.Almox.Numero">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.Almox.Botao">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Almox.Chip">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Almox.Toolbar">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/branco</item>
    </style>
</resources>
