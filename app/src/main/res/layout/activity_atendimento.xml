<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/concreto"
    android:orientation="vertical"
    tools:context=".AtendimentoActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Almox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:navigationContentDescription="Voltar"
        app:navigationIcon="@drawable/ic_back"
        app:title="Requisições pendentes">

        <!-- Contador de pendentes -->
        <TextView
            android:id="@+id/tvContador"
            style="@style/Almox.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/branco"
            android:fontFamily="monospace"
            android:minWidth="28dp"
            android:minHeight="28dp"
            android:text="5"
            android:textColor="@color/aco"
            android:textSize="14sp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRequisicoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="120dp"
            tools:listitem="@layout/item_requisicao" />

        <!-- Estado vazio (NC5) -->
        <LinearLayout
            android:id="@+id/layoutVazio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardBackgroundColor="@color/pendente_fundo"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/aco" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nenhuma requisição pendente"
                android:textAppearance="@style/TextAppearance.Almox.Titulo"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Quando um solicitante pedir material, o pedido aparece aqui."
                android:textAppearance="@style/TextAppearance.Almox.Detalhe"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Faixa de erro: saldo insuficiente (C5). Mostrar via código ao recusar a saída -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardErro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/erro_fundo"
            app:strokeColor="@color/erro"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/erro" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvErroTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo insuficiente"
                        android:textColor="@color/erro"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvErroMensagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rolamento 6204 ZZ: pedido de 4, saldo de 0. Registre uma entrada antes de atender."
                        android:textColor="@color/tinta"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
