<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/concreto"
    android:orientation="vertical"
    tools:context=".HomeAlmoxarifeActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Almox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:menu="@menu/menu_principal"
        app:title="Almoxarifado" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Saudação e perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSaudacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olá, Marcos"
                        android:textAppearance="@style/TextAppearance.Almox.Titulo"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/tvSetor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turno da tarde · Almoxarifado central"
                        android:textAppearance="@style/TextAppearance.Almox.Detalhe"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPerfil"
                    style="@style/Almox.Chip.Pendente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Almoxarife" />
            </LinearLayout>

            <!-- Ação principal -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLerCodigo"
                style="@style/Widget.Almox.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                android:text="Ler código de barras"
                android:textSize="19sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_scan"
                app:iconSize="32dp" />

            <!-- Atalhos: linha 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardItens"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_box"
                            app:tint="@color/aco" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Itens"
                            android:textAppearance="@style/TextAppearance.Almox.Nome"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEntrada"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            app:tint="@color/aco" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registrar entrada"
                            android:textAppearance="@style/TextAppearance.Almox.Nome"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Atalhos: linha 2 (com contadores) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPendentes"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_list"
                                app:tint="@color/aco" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Requisições pendentes"
                                android:textAppearance="@style/TextAppearance.Almox.Nome"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgePendentes"
                            style="@style/Almox.Chip.Estoque"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:backgroundTint="@color/aco"
                            android:fontFamily="monospace"
                            android:minWidth="28dp"
                            android:minHeight="28dp"
                            android:text="5"
                            android:textSize="14sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbaixoMinimo"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_alert"
                                app:tint="@color/alerta_texto" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Abaixo do mínimo"
                                android:textAppearance="@style/TextAppearance.Almox.Nome"
                                android:textSize="22sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeAbaixoMinimo"
                            style="@style/Almox.Chip.Alerta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:fontFamily="monospace"
                            android:minWidth="28dp"
                            android:minHeight="28dp"
                            android:text="3"
                            android:textSize="14sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Última requisição -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Última requisição"
                android:textAppearance="@style/TextAppearance.Almox.Secao" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUltimaRequisicao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUltimaItem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Parafuso sextavado M8 x 30"
                            android:textAppearance="@style/TextAppearance.Almox.Nome" />

                        <TextView
                            android:id="@+id/tvUltimaDetalhe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Linha de montagem 2 · 100 unidades"
                            android:textAppearance="@style/TextAppearance.Almox.Detalhe" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUltimaStatus"
                        style="@style/Almox.Chip.Pendente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendente" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
