<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/concreto"
    android:orientation="vertical"
    tools:context=".NovaRequisicaoActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Almox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:navigationContentDescription="Voltar"
        app:navigationIcon="@drawable/ic_back"
        app:title="Nova requisição" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Item escolhido -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ITEM"
                android:textAppearance="@style/TextAppearance.Almox.Rotulo" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvItemNome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Parafuso sextavado M8 x 30"
                            android:textAppearance="@style/TextAppearance.Almox.Nome" />

                        <TextView
                            android:id="@+id/tvItemLocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRATELEIRA B-04 · CX"
                            android:textAppearance="@style/TextAppearance.Almox.Rotulo" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrocarItem"
                        style="@style/Widget.Almox.Button.Outlined"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Trocar item lendo o código"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_scan"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quantidade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="QUANTIDADE"
                android:textAppearance="@style/TextAppearance.Almox.Rotulo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenos"
                    style="@style/Widget.Almox.Button.Outlined"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Diminuir quantidade"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_remove"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilQuantidade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="6"
                        android:text="1"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMais"
                    style="@style/Widget.Almox.Button.Outlined"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Aumentar quantidade"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSaldoDisponivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Saldo disponível: 148 caixas"
                android:textAppearance="@style/TextAppearance.Almox.Detalhe"
                android:textSize="13sp" />

            <!-- Destino -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDestino"
                style="@style/Widget.Almox.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Destino">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actDestino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Observação -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilObservacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Observação (opcional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarRequisicao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Enviar requisição"
                app:icon="@drawable/ic_send" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="O almoxarife vê o pedido na lista de requisições pendentes."
                android:textAppearance="@style/TextAppearance.Almox.Detalhe"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
