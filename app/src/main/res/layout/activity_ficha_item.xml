<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/concreto"
    android:orientation="vertical"
    tools:context=".FichaItemActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Almox.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:navigationContentDescription="Voltar"
        app:navigationIcon="@drawable/ic_back"
        app:title="Ficha do item" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parafuso sextavado M8 x 30"
                android:textAppearance="@style/TextAppearance.Almox.Titulo"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tvCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="7890000123456"
                android:textColor="@color/grafite"
                android:textSize="16sp" />

            <!-- Saldo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SALDO ATUAL"
                            android:textAppearance="@style/TextAppearance.Almox.Rotulo" />

                        <TextView
                            android:id="@+id/tvSaldo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="148"
                            android:textAppearance="@style/TextAppearance.Almox.Numero"
                            android:textSize="44sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/Almox.Chip.Estoque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:text="Em estoque"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Unidade, local e mínimo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UNIDADE"
                            android:textAppearance="@style/TextAppearance.Almox.Rotulo"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvUnidade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caixa"
                            android:textAppearance="@style/TextAppearance.Almox.Nome"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOCAL"
                            android:textAppearance="@style/TextAppearance.Almox.Rotulo"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvLocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="B-04"
                            android:textAppearance="@style/TextAppearance.Almox.Nome"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MÍNIMO"
                            android:textAppearance="@style/TextAppearance.Almox.Rotulo"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvMinimo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="40"
                            android:textAppearance="@style/TextAppearance.Almox.Nome"
                            android:textSize="22sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Ações por perfil: o código mostra só o botão do perfil logado -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Registrar entrada"
                android:visibility="gone"
                app:icon="@drawable/ic_add"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPedirItem"
                style="@style/Widget.Almox.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="52dp"
                android:text="Pedir este item"
                android:visibility="gone"
                app:icon="@drawable/ic_list"
                tools:visibility="visible" />

            <!-- Histórico -->
            <LinearLayout
                android:id="@+id/sectionHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Últimas movimentações"
                    android:textAppearance="@style/TextAppearance.Almox.Secao" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerTudo"
                    style="@style/Widget.Almox.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ver tudo" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMovimentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_movimento" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
